# Supabase connection. Use the *pooler* host: the direct db.<ref>.supabase.co
# host is IPv6-only, which serverless platforms (Netlify/Vercel) cannot reach.
# Port 6543 = transaction pooler (right for serverless), 5432 = session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Local dev server port (optional)
PORT=8888
